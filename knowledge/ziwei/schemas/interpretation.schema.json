{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qimen.local/schemas/ziwei/interpretation.schema.json",
  "title": "Ziwei Interpretation Proposition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "school",
    "scope",
    "status",
    "topics",
    "subject",
    "conditions",
    "claim",
    "modifier_notes",
    "modifiers",
    "language_policy",
    "evidence",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^interp\\.[a-z0-9._-]+\\.v[1-9][0-9]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "school": {
      "$ref": "#/definitions/school"
    },
    "scope": {
      "$ref": "#/definitions/scope"
    },
    "status": {
      "$ref": "#/definitions/status"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/topic"
      }
    },
    "subject": {
      "$ref": "#/definitions/subject"
    },
    "conditions": {
      "$ref": "#/definitions/conditionGroup"
    },
    "claim": {
      "$ref": "#/definitions/claim"
    },
    "modifier_notes": {
      "$ref": "#/definitions/modifierNotes"
    },
    "modifiers": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/modifier"
      }
    },
    "facet_annotations": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/facetAnnotation"
      }
    },
    "language_policy": {
      "$ref": "#/definitions/languagePolicy"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^source\\.[a-z0-9-]+\\.[a-z0-9.-]+$"
      }
    },
    "confidence": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high",
        "prohibited"
      ]
    }
  },
  "definitions": {
    "school": {
      "enum": [
        "iztro-default",
        "sanhe-core",
        "feixing-aux",
        "classical-reference"
      ]
    },
    "scope": {
      "enum": [
        "natal",
        "decadal",
        "yearly",
        "monthly",
        "daily",
        "hourly",
        "cross-period"
      ]
    },
    "status": {
      "enum": [
        "draft_ocr",
        "extracted",
        "visually_verified",
        "cross_checked",
        "reviewed",
        "deprecated"
      ]
    },
    "topic": {
      "enum": [
        "overall",
        "career",
        "wealth",
        "relationship",
        "health",
        "family",
        "travel",
        "learning"
      ]
    },
    "palace": {
      "enum": [
        "命宫",
        "兄弟宫",
        "夫妻宫",
        "子女宫",
        "财帛宫",
        "疾厄宫",
        "迁移宫",
        "交友宫",
        "官禄宫",
        "田宅宫",
        "福德宫",
        "父母宫"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "palace": {
          "$ref": "#/definitions/palace"
        },
        "stars": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mutagens": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "禄",
              "权",
              "科",
              "忌"
            ]
          }
        }
      }
    },
    "featurePredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature"
      ],
      "properties": {
        "feature": {
          "enum": [
            "chart_has_palace",
            "palace_role",
            "palace_has_star",
            "star_brightness",
            "star_mutagen",
            "palace_relation"
          ]
        },
        "palace": {
          "$ref": "#/definitions/palace"
        },
        "star": {
          "type": "string",
          "minLength": 1
        },
        "mutagen": {
          "enum": [
            "禄",
            "权",
            "科",
            "忌"
          ]
        },
        "value": {},
        "role": {
          "enum": [
            "body_palace",
            "origin_palace"
          ]
        },
        "collection": {
          "enum": [
            "major",
            "minor",
            "adjective"
          ]
        },
        "relation": {
          "enum": [
            "opposite",
            "trine",
            "adjacent"
          ]
        },
        "to": {
          "$ref": "#/definitions/palace"
        }
      }
    },
    "condition": {
      "anyOf": [
        {
          "$ref": "#/definitions/featurePredicate"
        },
        {
          "$ref": "#/definitions/conditionGroup"
        }
      ]
    },
    "conditionGroup": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/condition"
          }
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/condition"
          }
        },
        "not": {
          "$ref": "#/definitions/condition"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tendency",
        "strength"
      ],
      "properties": {
        "tendency": {
          "type": "string",
          "minLength": 1
        },
        "strength": {
          "enum": [
            "weak",
            "medium",
            "strong"
          ]
        }
      }
    },
    "modifierNotes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strengthen",
        "weaken"
      ],
      "properties": {
        "strengthen": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "weaken": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "featureLeaf": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature",
        "operator"
      ],
      "properties": {
        "feature": {
          "enum": [
            "palace_star_system",
            "relation_set",
            "brightness_state",
            "sanfang_aggregate",
            "jia_palace",
            "flying_mutagen",
            "empty_palace_borrow",
            "overlay_map",
            "period_mutagen",
            "mutagen_stack"
          ]
        },
        "palace": {
          "anyOf": [
            {
              "$ref": "#/definitions/palace"
            },
            {
              "const": "$matched_palace"
            }
          ]
        },
        "star": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "pattern": "^[a-z_]+(\\.[a-z_]+)*$"
        },
        "operator": {
          "enum": [
            "equals",
            "contains",
            "contains_any",
            "contains_all",
            "gte",
            "lte",
            "count_gte",
            "exists",
            "not_exists"
          ]
        },
        "value": {}
      }
    },
    "featureCondition": {
      "anyOf": [
        {
          "$ref": "#/definitions/featureLeaf"
        },
        {
          "$ref": "#/definitions/featureConditionGroup"
        }
      ]
    },
    "featureConditionGroup": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/featureCondition"
          }
        },
        "any": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/featureCondition"
          }
        },
        "not": {
          "$ref": "#/definitions/featureCondition"
        }
      }
    },
    "modifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "when",
        "effect",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^mod\\.[a-z0-9._-]+$"
        },
        "when": {
          "$ref": "#/definitions/featureConditionGroup"
        },
        "effect": {
          "enum": [
            "strengthen",
            "weaken",
            "redirect",
            "negate"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^source\\.[a-z0-9-]+\\.[a-z0-9.-]+$"
          }
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "facetAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "polarity",
        "review_status"
      ],
      "properties": {
        "slot": {
          "enum": [
            "subject_state",
            "target_state",
            "environment",
            "support",
            "constraint",
            "interaction",
            "timing",
            "portrait",
            "guidance"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "subcategory": {
          "type": "string",
          "minLength": 1
        },
        "facet": {
          "type": "string",
          "pattern": "^[a-z_]+$"
        },
        "polarity": {
          "enum": [
            "positive",
            "negative",
            "neutral"
          ]
        },
        "review_status": {
          "enum": [
            "draft",
            "reviewed"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "dependencies": {
        "facet": [
          "category",
          "subcategory"
        ],
        "subcategory": [
          "category"
        ]
      }
    },
    "languagePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic",
        "forbidden_phrases"
      ],
      "properties": {
        "deterministic": {
          "const": false
        },
        "forbidden_phrases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
