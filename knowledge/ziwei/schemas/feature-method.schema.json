{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://qimen.local/schemas/ziwei/feature-method.schema.json",
  "title": "Ziwei Feature Derivation Method",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "feature",
    "school",
    "basis",
    "status",
    "evidence",
    "depends_on",
    "description"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^method\\.feature\\.[a-z0-9-]+\\.v[1-9][0-9]*$"
    },
    "feature": {
      "enum": [
        "palace_star_system",
        "relation_set",
        "brightness_state",
        "sanfang_aggregate",
        "jia_palace",
        "flying_mutagen",
        "empty_palace_borrow",
        "overlay_map",
        "period_mutagen",
        "mutagen_stack"
      ]
    },
    "school": {
      "enum": [
        "iztro-default",
        "sanhe-core",
        "feixing-aux",
        "classical-reference"
      ]
    },
    "basis": {
      "enum": [
        "chart_fact",
        "sourced_method"
      ]
    },
    "status": {
      "enum": [
        "reviewed",
        "pending_source"
      ]
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^source\\.[a-z0-9-]+\\.[a-z0-9.-]+$"
      }
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    }
  }
}
